{
  "name": "fairfood_collector",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ios": "react-native run-ios",
    "start": "npx react-native start",
    "run-testing": "ENVFILE=.env.testing npx react-native run-android",
    "run-dev": "ENVFILE=.env.development npx react-native run-android",
    "run-staging": "ENVFILE=.env.staging npx react-native run-android",
    "run-prod": "ENVFILE=.env.production npx react-native run-android",
    "debug": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:9090 tcp:9090",
    "clean": "cd android && ./gradlew clean && cd ../",
    "reset-cache": "yarn start --reset-cache",
    "apk-dev": "cd android && ENVFILE=.env.development ./gradlew assembleRelease && cd ../",
    "apk-staging": "cd android && ENVFILE=.env.staging ./gradlew assembleRelease && cd ../",
    "apk-prod": "cd android && ENVFILE=.env.production ./gradlew assembleRelease && cd ../",
    "aab-dev": "cd android && ENVFILE=.env.development ./gradlew bundleRelease && cd ../",
    "aab-staging": "cd android && ENVFILE=.env.staging ./gradlew bundleRelease && cd ../",
    "aab-prod": "cd android && ENVFILE=.env.production ./gradlew bundleRelease && cd ../",
    "test": "jest",
    "test-coverage": "jest --coverage",
    "test-report": "jest --coverage --coverageReporters",
    "lint": "eslint .",
    "codepush_app": "ENVFILE=.env.production appcenter codepush release-react -a shyno-fairfood.org/fairfood_collector -d Production",
    "detox-build-att": "ENVFILE=.env.testing npx detox build --configuration android.emu.release",
    "detox-test-att": "ENVFILE=.env.testing npx detox test --configuration android.emu.release --testPathPattern='./__test__/detox/'",
    "detox-test-att-login": "ENVFILE=.env.testing npx detox test --configuration android.emu.release --testPathPattern='./__test__/detox/login/login.test.js'",
    "detox-test-att-buy": "ENVFILE=.env.testing npx detox test --configuration android.emu.release --testPathPattern='./__test__/detox/buy/buy.test.js'",
    "detox-test-att-addFarmer": "ENVFILE=.env.testing npx detox test --configuration android.att.release --testPathPattern='./__test__/detox/farmer/addFarmer.test.js'",
    "detox-test-att-editFarmer": "ENVFILE=.env.testing npx detox test --configuration android.att.release --testPathPattern='./__test__/detox/farmer/editFarmer.test.js'",
    "detox-test-att-farmerDetails": "ENVFILE=.env.testing npx detox test --configuration android.att.release --testPathPattern='./__test__/detox/farmer/farmerDetails.test.js'",
    "detox-test-att-payFarmer": "ENVFILE=.env.testing npx detox test --configuration android.att.release --testPathPattern='./__test__/detox/payFarmer/payFarmer.test.js'",
    "detox-test-att-send": "ENVFILE=.env.testing npx detox test --configuration android.att.release --testPathPattern='./__test__/detox/send/send.test.js'",
    "detox-clean": "rm -rf ~/Library/Detox",
    "open-apk": "open ./android/app/build/outputs/apk/release",
    "open-aab": "open ./android/app/build/outputs/bundle/release",
    "postinstall": "patch-package",
    "prepare": "husky install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-native-community/cli": "11.3.1",
    "@react-native-community/netinfo": "^11.3.2",
    "@react-native-firebase/analytics": "^18.8.0",
    "@react-native-firebase/app": "^18.8.0",
    "@react-native-firebase/crashlytics": "^18.8.0",
    "@react-navigation/bottom-tabs": "^6.5.7",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/stack": "^6.3.16",
    "@reduxjs/toolkit": "^2.2.7",
    "@sentry/react-native": "^5.31.1",
    "axios": "^1.7.6",
    "i18n-js": "^4.2.3",
    "libphonenumber-js": "^1.10.49",
    "moment": "^2.30.1",
    "papaparse": "^5.4.1",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react": "18.3.1",
    "react-native": "0.75.2",
    "react-native-base64": "^0.2.1",
    "react-native-bluetooth-state-manager": "^1.3.5",
    "react-native-camera": "^4.2.1",
    "react-native-code-push": "^8.3.1",
    "react-native-collapsible": "1.6.1",
    "react-native-config": "^1.5.3",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-date-picker": "^5.0.7",
    "react-native-device-info": "^11.1.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-file-viewer": "^2.1.5",
    "react-native-fs": "^2.20.0",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "^2.18.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-html-to-pdf": "^0.12.0",
    "react-native-image-crop-picker": "^0.41.2",
    "react-native-nfc-manager": "^3.15.1",
    "react-native-permissions": "^4.1.5",
    "react-native-pkce-challenge": "^5.3.2",
    "react-native-progress": "^5.0.1",
    "react-native-qrcode-scanner": "^1.5.5",
    "react-native-reanimated": "^3.16.1",
    "react-native-reanimated-carousel": "^3.5.1",
    "react-native-safe-area-context": "^4.10.9",
    "react-native-screens": "^3.34.0",
    "react-native-svg": "^15.6.0",
    "react-native-thermal-printer": "^2.3.6",
    "react-native-toast-message": "^2.2.0",
    "react-native-tts": "^4.1.1",
    "react-native-webview": "^13.12.2",
    "react-redux": "^9.1.2",
    "realm": "^12.13.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "sp-react-native-in-app-updates": "^1.4.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-proposal-decorators": "^7.22.3",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@eslint/js": "^9.14.0",
    "@react-native/babel-preset": "0.75.2",
    "@react-native/eslint-config": "0.75.2",
    "@react-native/metro-config": "0.75.2",
    "@react-native/typescript-config": "0.75.2",
    "@testing-library/react-native": "^12.6.1",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "^29.5.3",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^29.6.3",
    "detox": "^20.26.2",
    "eslint": "8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsdoc": "^45.0.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.3.0",
    "globals": "^15.12.0",
    "husky": "8.0.3",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "redux-mock-store": "^1.5.4",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@3.6.4"
}
